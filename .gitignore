package-lock.json
pnpm-lock.yaml
*.tgz

# Next.js / build outputs
.next/
out/
dist/
build/
.cache/
.nyc_output/
*.log

# TypeScript
*.tsbuildinfo

# Environment and secrets
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup

# Editor / OS
.vscode/
.idea/
*.sublime-*
*.swp
.DS_Store
Thumbs.db

# Tests / coverage
coverage/
.coverage/
.vitest/
jest-results.*.json
test-results/

